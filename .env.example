# --- Web (Flask) ---
# Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ADMIN_USERNAME=admin
# Buat dengan: python scripts/hash_password.py   (tulis hasilnya di antara tanda kutip tunggal)
ADMIN_PASSWORD_HASH=
DATABASE_PATH=instance/projectpulse.db

# --- GitHub (dipakai penjadwal dan perintah CLI) ---
# Token baca-saja untuk data publik; tanpa hak akses tambahan.
GITHUB_TOKEN=

# --- Telegram (dipakai bot dan penjadwal) ---
# Dari BotFather.
TELEGRAM_BOT_TOKEN=

# --- Penjadwal ---
TIMEZONE=Asia/Jakarta
SCRAPE_HOUR=7
SCRAPE_MINUTE=0

# --- Opsional ---
# Tautan dashboard yang disertakan pada pesan bot.
DASHBOARD_URL=http://127.0.0.1:5000/dashboard
